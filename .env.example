MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=resume_matcher
MYSQL_USER=resume_user
MYSQL_PASSWORD=changeme_user_password

MATCHING_SEMANTIC_ENABLED=false
EMBEDDING_API_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=changeme_embedding_api_key
EMBEDDING_MODEL=text-embedding-3-small

ANALYSIS_ENABLED=false
CHAT_API_BASE_URL=https://api.example.com/v1
CHAT_API_KEY=changeme_chat_api_key
CHAT_API_MODEL=gpt-4o-mini

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_RPM=60
RATE_LIMIT_OPENAI_RPM=10

# Required - the app will not start without this. Must be at least 32
# characters (256 bits) for HS256 signing. The value below is a placeholder
# for local development only; generate a real random secret for any
# deployed environment (e.g. `openssl rand -base64 48`).
JWT_SECRET=changeme_jwt_signing_secret_at_least_32_bytes_long
JWT_EXPIRATION_HOURS=24
